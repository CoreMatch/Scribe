SCRIBE_LISTEN_ADDR=:8080
SCRIBE_PUBLIC_BASE_URL=https://auth.example.com
SCRIBE_LEGACY_BASE_URL=https://legacy.internal
SCRIBE_ARMIORIAL_BASE_URL=https://armorial.internal
SCRIBE_REDIS_URL=rediss://scribe:replace-with-redis-password@redis.internal:6379/0
SCRIBE_MIGRATION_SERVICE_TOKEN=replace-with-armorial-service-token
SCRIBE_MIGRATION_TTL=24h
SCRIBE_MIGRATION_MAX_PACKAGE_BYTES=16777216
SCRIBE_MIGRATION_TIMEOUT=60s
SCRIBE_SQLITE_PATH=/data/scribe.db
SCRIBE_UPSTREAM_TIMEOUT=15s
SCRIBE_SHUTDOWN_TIMEOUT=15s
SCRIBE_WRITE_TIMEOUT=150s
SCRIBE_MAX_REQUEST_BODY=1048576
SCRIBE_AUTH_RATE_LIMIT=5
SCRIBE_AUTH_BURST=10
SCRIBE_RATE_LIMIT_MAX_ENTRIES=65536
SCRIBE_CIRCUIT_FAILURE_THRESHOLD=5
SCRIBE_CIRCUIT_OPEN_TIMEOUT=10s
SCRIBE_CIRCUIT_HALF_OPEN_MAX_REQUESTS=1
